# Copy this file to .env and adjust values before running in production.

PORT=3000
NODE_ENV=production

# Used to sign session cookies. Set this to a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Firebase service account credentials to use Firestore.
# You can set FIREBASE_SERVICE_ACCOUNT_JSON to the raw JSON object,
# or set the individual fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=

# Seeded once on first run if no admin account exists yet.
ADMIN_EMAIL=admin@printflow.com
ADMIN_PASSWORD=change-this-password

# Supabase Auth, database records, and Storage.
# Set SUPABASE_ENABLED=false to use the local JSON/Firebase fallback.
SUPABASE_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=printflowdoc
SUPABASE_DATA_TABLE=printflow_records
SUPABASE_AUTO_CONFIRM_EMAIL=true

# KCB Buni OAuth. Never commit the real secret.
BUNI_ENABLED=false
BUNI_API_KEY=
BUNI_BASE_URL=https://uat.buni.kcbgroup.com
BUNI_MPESA_EXPRESS_PATH=/mm/api/request/1.0.0
BUNI_FUNDS_TRANSFER_PATH=/fundstransfer/1.0.0
BUNI_TILL_NUMBER=
BUNI_SHARED_SHORT_CODE=true
BUNI_ORG_SHORT_CODE=
BUNI_ORG_PASS_KEY=
BUNI_TRANSACTION_DESCRIPTION=PrintFlow payment
BUNI_CONSUMER_KEY=
BUNI_CONSUMER_SECRET=
BUNI_TOKEN_URL=https://uat.buni.kcbgroup.com/token?grant_type=client_credentials
BUNI_REVOKE_URL=https://accounts.buni.kcbgroup.com/oauth2/revoke
BUNI_PAYMENT_URL=
BUNI_CALLBACK_URL=
